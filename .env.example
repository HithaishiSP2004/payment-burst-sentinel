# Payment Burst Sentinel — Environment Configuration
# Copy to .env and fill in your values

# ── AI Investigation Intelligence (Phase 15) ──────────────
# Gemini API key — obtain from https://aistudio.google.com/apikey
# NEVER commit your actual key. This file is .env.example only.
GEMINI_API_KEY=

# Configurable Flash model cascade: primary model with fallback support
GEMINI_MODEL=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-2.5-flash

# Enable/disable AI features (true/false)
AI_ENABLED=true

# ── Backend ───────────────────────────────────────────────
# CORS origins (comma-separated). Leave empty for development (allows all).
ALLOWED_ORIGINS=

# ── Integration Readiness (Phase 16) ──────────────────────
# Current data mode: dataset (default), demo, sandbox
INTEGRATION_MODE=dataset

# Razorpay integration boundary — readiness only, NOT live connectivity
RAZORPAY_INTEGRATION_ENABLED=false
RAZORPAY_WEBHOOK_SECRET=
